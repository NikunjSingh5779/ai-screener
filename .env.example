# Optional cloud key. Leave empty/unset for fully local operation.
# OPENROUTER_API_KEY=

# Local-only Ollama inference:
# AI_TRADER_PROVIDERS=ollama,noop
# AI_TRADER_OLLAMA_MODEL=qwen2.5-vl:7b

# Local OpenAI-compatible inference (LM Studio / llama.cpp server):
# AI_TRADER_PROVIDERS=lmstudio,noop
# AI_TRADER_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# AI_TRADER_LMSTUDIO_MODEL=your-loaded-vision-model-id

# Advisory risk settings only; account size 0 disables sizing.
# AI_TRADER_ACCOUNT_SIZE=0
# AI_TRADER_RISK_PCT=0.5
