# AI Trader provider keys — copy this file to `.env` and fill in your keys.
# `.env` is gitignored; keys never get committed. Loading is automatic at
# startup (stdlib-only reader in ai_trader/providers.py).

# Free-tier vision provider (recommended, $0). With this set, OpenRouter is
# the first choice on every read and ollama stays as the offline fallback.
OPENROUTER_API_KEY=sk-or-...
# Optional: override the free model configured in config.toml.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Paid alternative; same logic — a set key promotes Anthropic to first choice.
# ANTHROPIC_API_KEY=sk-ant-...

# Validation mode: set to 1 to exclude local providers (ollama) from the
# chain so a run proves a specific cloud provider.
# AI_TRADER_SKIP_LOCAL=0