# Optional cloud key. Leave empty/unset for fully local operation.
# OPENROUTER_API_KEY=

# Local-only Ollama inference:
# AI_TRADER_PROVIDERS=ollama,noop
# AI_TRADER_OLLAMA_MODEL=qwen2.5-vl:7b

# PolyStrata / Strata local image-capable API (start one runtime on port 8080):
# AI_TRADER_PROVIDERS=polystrata,noop
# AI_TRADER_POLYSTRATA_BASE_URL=http://127.0.0.1:8080/v1
# AI_TRADER_POLYSTRATA_MODEL=strata
# AI_TRADER_POLYSTRATA_API_KEY=
#
# Local OpenAI-compatible inference (LM Studio / llama.cpp server):
# AI_TRADER_PROVIDERS=lmstudio,noop
# AI_TRADER_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# AI_TRADER_LMSTUDIO_MODEL=your-loaded-vision-model-id

# Advisory risk settings only; account size 0 disables sizing.
# AI_TRADER_ACCOUNT_SIZE=0
# AI_TRADER_RISK_PCT=0.5

# Auto-detect both Indian and US equities from a clearly visible TradingView
# exchange/symbol label; pin to NSE, BSE, or US if desired.
# AI_TRADER_MARKET=AUTO

# Separate account balances are required for quote-currency-correct sizing.
# AI_TRADER_ACCOUNT_SIZE_INR=0
# AI_TRADER_ACCOUNT_SIZE_USD=0
# Legacy single balance only applies when AI_TRADER_ACCOUNT_CURRENCY matches
# the instrument currency (INR for NSE/BSE, USD for US equities).
# AI_TRADER_ACCOUNT_CURRENCY=INR
