# Strict local inference: PolyStrata/Strata only (no fallback provider)
AI_TRADER_PROVIDERS=polystrata
AI_TRADER_POLYSTRATA_BASE_URL=http://127.0.0.1:8080/v1
AI_TRADER_POLYSTRATA_MODEL=qwen3.6-35b-a3b-ud-q4_k_m
AI_TRADER_POLYSTRATA_API_KEY=

# USD account currency. Set balances to your actual available capital when ready.
AI_TRADER_MARKET=US
AI_TRADER_ACCOUNT_CURRENCY=USD
AI_TRADER_ACCOUNT_SIZE=0
AI_TRADER_ACCOUNT_SIZE_USD=0
AI_TRADER_ACCOUNT_SIZE_INR=0
AI_TRADER_RISK_PCT=0.5
